{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafish.example/schemas/allegro-cost-model.schema.json",
  "title": "AllegroCostModel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "currency",
    "taxBasis",
    "complete",
    "purchaseNet",
    "inboundFreightNet",
    "packagingMaterialsNet",
    "packagingLaborNet",
    "paymentFeesNet",
    "allegroBaseCommissionNet",
    "allegroFixedFeesNet",
    "smartContributionNet",
    "carrierBaseNet",
    "carrierSurchargesNet",
    "codFeeNet",
    "promotionFixedNet",
    "promotionCommissionNet",
    "adsAttributedNet",
    "returnsReserveNet",
    "damageReserveNet",
    "otherNet",
    "salesPriceGross",
    "salesRevenueNet",
    "totalVariableCostNet",
    "contributionMarginNet",
    "contributionMarginPct",
    "minimumContributionMarginNet",
    "calculatedAt",
    "sourceRefs"
  ],
  "properties": {
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "taxBasis": {"enum": ["NET", "GROSS", "MIXED_REQUIRES_REVIEW"]},
    "complete": {"type": "boolean"},
    "purchaseNet": {"$ref": "#/$defs/cost"},
    "inboundFreightNet": {"$ref": "#/$defs/cost"},
    "packagingMaterialsNet": {"$ref": "#/$defs/cost"},
    "packagingLaborNet": {"$ref": "#/$defs/cost"},
    "paymentFeesNet": {"$ref": "#/$defs/cost"},
    "allegroBaseCommissionNet": {"$ref": "#/$defs/cost"},
    "allegroFixedFeesNet": {"$ref": "#/$defs/cost"},
    "smartContributionNet": {"$ref": "#/$defs/cost"},
    "carrierBaseNet": {"$ref": "#/$defs/cost"},
    "carrierSurchargesNet": {"$ref": "#/$defs/cost"},
    "codFeeNet": {"$ref": "#/$defs/cost"},
    "promotionFixedNet": {"$ref": "#/$defs/cost"},
    "promotionCommissionNet": {"$ref": "#/$defs/cost"},
    "adsAttributedNet": {"$ref": "#/$defs/cost"},
    "returnsReserveNet": {"$ref": "#/$defs/cost"},
    "damageReserveNet": {"$ref": "#/$defs/cost"},
    "otherNet": {"$ref": "#/$defs/cost"},
    "salesPriceGross": {"$ref": "#/$defs/calculatedMoney"},
    "salesRevenueNet": {"$ref": "#/$defs/calculatedMoney"},
    "totalVariableCostNet": {"$ref": "#/$defs/calculatedMoney"},
    "contributionMarginNet": {"$ref": "#/$defs/calculatedMoney"},
    "contributionMarginPct": {"type": ["number", "null"]},
    "minimumContributionMarginNet": {"type": "number"},
    "calculatedAt": {"type": "string", "format": "date-time"},
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "sourceRef", "effectiveAt"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0},
        "status": {"enum": ["KNOWN", "ZERO_CONFIRMED", "UNKNOWN", "NOT_APPLICABLE"]},
        "sourceRef": {"type": ["string", "null"]},
        "effectiveAt": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "calculatedMoney": {"type": ["number", "null"]}
  }
}
